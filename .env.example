# Reference only: the app reads environment variables, not this file.
# Enter real values in Render's Environment settings, never in GitHub.
WEDDING_BACKEND=cloud
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres
R2_ACCOUNT_ID=YOUR_32_CHARACTER_CLOUDFLARE_ACCOUNT_ID
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
R2_BUCKET=wedding-photos
# Add this only on the server to enable the advanced photo editor.
OPENAI_API_KEY=YOUR_OPENAI_PROJECT_API_KEY
OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
